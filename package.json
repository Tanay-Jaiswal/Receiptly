{
  "name": "receiptly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:data && tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "generate:data": "tsx scripts/build-data.ts",
    "build:data": "tsx scripts/build-data.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "date-fns": "4.4.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.47.0",
    "motion": "13.4.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.8",
    "tsx": "^4.23.14",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
